      "parameters": {
        "formTitle": "Candidate Status Update",
        "formDescription": "Enter the candidate details and choose their status. The matching email is sent automatically.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Candidate Name",
              "fieldName": "candidateName",
              "requiredField": true
            },
            {
              "fieldLabel": "Candidate Email",
              "fieldType": "email",
              "fieldName": "candidateEmail",
              "requiredField": true
            },
            {
              "fieldLabel": "Position",
              "fieldName": "position",
              "requiredField": true
            },
            {
              "fieldLabel": "Status",
              "fieldType": "dropdown",
              "fieldName": "status",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Under Review"
                  },
                  {
                    "option": "Rejected"
                  },
                  {
                    "option": "Offered"
                  }
                ]
              },
              "requiredField": true
            },
