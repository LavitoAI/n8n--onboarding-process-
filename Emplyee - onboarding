    {
      "parameters": {
        "operation": "sendAndWait",
        "sendTo": "={{ $json.candidateEmail }}",
        "subject": "Job offer - welcome aboard!",
        "message": "=<p>Hi {{ $json.candidateName }},</p><p>Congratulations! We are delighted to offer you the <b>{{ $json.position }}</b> role.</p>{{ $json.startDate ? \"<p>Your proposed start date is <b>\" + $json.startDate + \"</b>.</p>\" : \"\" }}<p><b>Next steps for onboarding:</b></p><ul><li>Reply to confirm you accept the offer.</li><li>Send us your ID, banking details and tax information.</li><li>Watch for your welcome pack and first-day schedule.</li><li>Please also let us know your notice period</li></ul>{{ $json.notes ? \"<p>\" + $json.notes + \"</p>\" : \"\" }}<p>Welcome to the team!<br>The Hiring Team</p>",
        "options": {
          "appendAttribution": false
        }
      },
