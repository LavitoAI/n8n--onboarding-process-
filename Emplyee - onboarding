    {
      "parameters": {
        "text": "=From: {{ $json.from.text }}\nSubject: {{ $json.subject }}\n\n{{ $json.text }}",
        "attributes": {
          "attributes": [
            {
              "name": "candidateName",
              "description": "Full name of the candidate who wrote the reply"
            },
            {
              "name": "startDate",
              "description": "The start date the candidate confirms or proposes, formatted YYYY-MM-DD. If they accept without naming a new date, use the proposed start date from the quoted offer email. Leave empty if no date can be found."
            },
            {
              "name": "accepted",
              "type": "boolean",
              "description": "True if the candidate accepts the job offer"
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "=You read candidate replies to job offer emails. Today is {{ $now.toISODate() }}. Prefer what the candidate wrote in their own reply over the quoted original email. Only extract values that are present; never invent a date."
        }
